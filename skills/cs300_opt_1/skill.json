{
  "name": "cs300_opt_1",
  "version": "2.0.0",
  "display_name": "沪深300优选策略一回测（4因子逆波动率加权）",
  "description": "声明式策略回测：沪深300成分股内按 4 因子 z-score 逆波动率（IV）加权综合评分选 Top10 等权，月度调仓。因子面板、38 期权重表、成分区间与涨跌停价内嵌自数据库导出；撮合与费率与原始策略一致（收盘价整百股、int() 四舍五入、资金不足整单拒单、触涨停买单不成交跳过）。",
  "runtime": "agent_python",
  "entry": "SKILL.md",
  "python_entry": "backtest.py",
  "workflow": "workflow.json",
  "allowed_tools": [
    "app_dq_trade_calendar",
    "app_dq_index_quote",
    "app_dq_index_constituents_by_name",
    "app_dq_stock_quote"
  ],
  "max_tool_calls": 12,
  "max_rounds": 8,
  "python_hooks": [
    {
      "name": "run_backtest",
      "entry": "backtest.py",
      "inputs": [],
      "output": "strategy_result.v1"
    }
  ],
  "output_contract": {
    "format": "markdown",
    "template": "report.md"
  },
  "permissions": {
    "fs_read": ["./skill_runs/cs300_opt_1/"],
    "fs_write": ["./skill_runs/cs300_opt_1/"],
    "network": [],
    "subprocess": []
  }
}
