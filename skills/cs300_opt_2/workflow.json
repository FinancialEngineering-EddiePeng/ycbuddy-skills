{
  "version": 2,
  "kind": "strategy_backtest",
  "params": [
    {
      "name": "start",
      "type": "date",
      "default": "2024-01-02",
      "description": "回测开始日期"
    },
    {
      "name": "end",
      "type": "date",
      "default": "2026-11-10",
      "description": "回测结束日期"
    },
    {
      "name": "universe",
      "type": "enum",
      "default": "CSI300",
      "enum_values": [
        "CSI300"
      ],
      "description": "股票池（成分区间内嵌，固定沪深300）"
    },
    {
      "name": "benchmark",
      "type": "string",
      "default": "000300",
      "description": "基准指数代码"
    }
  ],
  "constraints": [
    {
      "rule": "lt",
      "left": "start",
      "right": "end"
    }
  ],
  "strategy": {
    "id": "cs300_opt_2",
    "name": "沪深300优选策略二（4因子等权 EQ加权月度Top10）",
    "family": "multi_factor",
    "version": "2.0.0",
    "asset_class": "equity",
    "direction": "long_only",
    "tags": [
      "multi_factor",
      "eq_weight",
      "scheduled",
      "monthly",
      "a_share"
    ]
  },
  "rebalance": {
    "mode": "scheduled",
    "frequency": "monthly",
    "calendar_rule": "month_first_trading_day",
    "signal_timing": "close",
    "execution_timing": "next_open"
  },
  "steps": [
    {
      "id": "build_dataset",
      "type": "dataset",
      "builder": "equity_backtest_bundle.v1",
      "label": "构建回测数据集（日历/股票池/个股与基准行情）",
      "args": [
        {
          "start": "${input.start}",
          "end": "${input.end}",
          "warmup_trading_days": 60,
          "universe": "${input.universe}",
          "benchmark": "${input.benchmark}",
          "adjustment": "forward"
        }
      ]
    },
    {
      "id": "run_backtest",
      "type": "python_hook",
      "hook": "run_backtest",
      "label": "运行沪深300优选策略二回测（4因子加权，内嵌数据撮合）"
    },
    {
      "id": "validate_outputs",
      "type": "validate",
      "contract": "strategy_backtest.v1",
      "label": "校验回测产物（strategy_backtest.v1）"
    },
    {
      "id": "commit_run",
      "type": "commit",
      "label": "原子提交回测产物"
    }
  ]
}